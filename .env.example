PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# The engine calls an OpenAI-compatible endpoint. Point OPENAI_BASE_URL at
# OpenAI, OpenRouter, or a local server (Ollama, vLLM). Without OPENAI_API_KEY,
# policy drafting falls back to the deterministic compiler and agent runs return
# model_unavailable.
#   OpenAI:     OPENAI_BASE_URL=https://api.openai.com/v1   MODEL=gpt-4o-mini
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1 MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL=openai/gpt-4o-mini
MODEL_PROVIDER=openai
# Optional public web research for published agents (Tavily Search API key).
# Keep this only in the engine environment; it is never exposed to the browser.
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
# Used by the Studio's Better Auth client.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3001

# Engine. The prototype is gone; these are the process settings.
# Neon example: postgresql://user:password@host/dbname?sslmode=require
# postgresql:// is accepted and rewritten to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://mandate:mandate@localhost:5432/mandate
REDIS_URL=redis://localhost:6379/0
BETTER_AUTH_SECRET=
APPROVAL_SIGNING_KEY=
BETTER_AUTH_URL=http://localhost:3001
MANDATE_API_URL=http://127.0.0.1:8001
STUDIO_URL=http://localhost:3001
